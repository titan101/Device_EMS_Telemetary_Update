# Standard Junos EMS and telemetry baseline generated by Device EMS Telemetary Update.
{% if desired.cleanup_old_tacacs %}
{% for server in existing.tacacs_servers %}
{% if server not in desired.tacacs_servers %}
delete system tacplus-server {{ server }}
{% endif %}
{% endfor %}
{% endif %}
{% if desired.cleanup_old_radius %}
{% for line in existing.radius_delete_lines %}
{{ line }}
{% endfor %}
{% endif %}
{% for server in desired.tacacs_servers %}
set system tacplus-server {{ server }} timeout {{ desired.tacacs_timeout }}
{% if desired.tacacs_secret %}
set system tacplus-server {{ server }} secret {{ desired.tacacs_secret|junos_quote }}
{% endif %}
{% endfor %}
{% if desired.auth_order_tacacs_then_local and desired.tacacs_servers %}
set system authentication-order tacplus
set system authentication-order password
{% endif %}
{% if desired.cleanup_old_ntp %}
{% for server in existing.ntp_servers %}
{% if server not in desired.ntp_servers %}
delete system ntp server {{ server }}
{% endif %}
{% endfor %}
{% endif %}
{% for server in desired.ntp_servers %}
set system ntp server {{ server }}{% if loop.first and desired.ntp_prefer_first %} prefer{% endif %}
{% endfor %}
{% if desired.cleanup_old_syslog %}
{% for host in existing.syslog_hosts %}
{% if host not in desired.syslog_hosts %}
delete system syslog host {{ host }}
{% endif %}
{% endfor %}
{% endif %}
{% for host in desired.syslog_hosts %}
set system syslog host {{ host }} any {{ desired.syslog_any_severity }}
{% endfor %}
{% if desired.cleanup_old_snmp %}
{% for community in existing.snmp_communities %}
{% if community not in desired.snmp_communities %}
delete snmp community {{ community }}
{% endif %}
{% endfor %}
{% endif %}
{% for community in desired.snmp_communities %}
set snmp community {{ community }} authorization {{ desired.snmp_authorization }}
{% for client in desired.snmp_clients %}
set snmp community {{ community }} clients {{ client }}
{% endfor %}
{% endfor %}
{% if desired.enable_netconf %}
set system services netconf ssh
{% endif %}
{% if desired.enable_lldp %}
set protocols lldp interface all
{% endif %}
